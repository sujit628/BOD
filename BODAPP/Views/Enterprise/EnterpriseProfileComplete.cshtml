                                                                <i class="ti ti-upload d-block d-sm-none"></i>
                                                                <input type="file" id="upload" class="account-file-input" data-max-size="300000" hidden accept="image/png" onchange="ShowPreview(this)" />
                                                            </label>
                                                            <button id="btnResetUpload" type="reset" class="btn btn-label-secondary account-image-reset mb-3">
                                                                <i class="ti ti-refresh-dot d-block d-sm-none"></i>
                                                                <span class="d-none d-sm-block">Reset</span>
                                                            </button>

                                                            <div class="text-muted">Allowed Only PNG Image - Rectanglar Orientation. Max size of 800K</div>
                                                        </div>
                                                    </div>
