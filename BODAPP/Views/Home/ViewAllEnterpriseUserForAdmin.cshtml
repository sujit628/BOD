<div class="modal fade" id="setUPFormEnterpriseUserForAdminModal" tabindex="-1" aria-labelledby="setUPFormEnterpriseUserForAdminModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-end">
        <div class="modal-content">
