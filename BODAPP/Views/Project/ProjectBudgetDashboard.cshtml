                            </div>
                            <div class="col-4 mb-4">
                                <label for="txtAmnt" class="form-label">Available Budget for <span id="txtActLabelTask" class="txtActLabelTask txtaskSpan"></span></label>
                                <input type="text" class="form-control txtask" id="txtTotalAvailableBudgetTask" name="txtTotalAvailableBudgetTask" disabled />
                                <input type="hidden" class="form-control txtask" id="hdnTotalAvailableBudgetTask" name="hdnTotalAvailableBudgetTask" />
                            </div>
                        </div>


