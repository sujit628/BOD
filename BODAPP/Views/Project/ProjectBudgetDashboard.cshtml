                        </div>
                    </div>
                    <div class="row">
                        <div class="col-4 mb-4">
                            <label for="ddlTaskSMME" class="form-label">Task</label>
                            <select id="ddlTaskSMME" name="ddlTaskSMME" class="select2 form-select ddlTaskSMME txSMME" data-allow-clear="true"></select>
                        </div>
                        <div class="col-4 mb-4">
                            <label for="txtAmnt" class="form-label">Total Budget for <span id="txtTaskLabelSMME2" class="txtTaskLabelSMME txSMMESpan txlblActTaskClr"></span></label>
                            <input type="text" class="form-control txSMME" id="txtTotalTaskBudgetSMME" name="txtTotalTaskBudgetSMME" value="" disabled />
                        </div>
                        <div class="col-4 mb-4">
                            <label for="txtAmnt" class="form-label">Available Budget for <span id="txtTaskLabelSMME" class="txtTaskLabelSMME txSMMESpan txlblActTaskClr"></span></label>
                            <input type="text" class="form-control txSMME" id="txtTotalAvailableBudgetTaskSMME" name="txtTotalAvailableBudgetTaskSMME" disabled />
                            <input type="hidden" id="hdnTotalAvailableBudgetTaskSMME" name="hdnTotalAvailableBudgetTaskSMME" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-4 mb-4">
                            <label for="ddlSMME" class="form-label">SMME<span class="text-danger">*</span></label>
                            <select id="ddlSMME" name="ddlSMME" class="select2 form-select ddlSMME txSMME" data-allow-clear="true"></select>
                        </div>
                        <div class="col-3 mb-3">
                            <label for="txtSMMEAmnt" class="form-label">Amount<span class="text-danger">*</span></label>
                            <input type="text" class="form-control txtModal txSMME" id="txtSMMEAmnt" placeholder="Enter task Amount " onkeyup="cellAmntForSMMEBudget(this)" name="txtSMMEAmnt" onkeydown="    return !((event.keyCode < 48 || event.keyCode > 57) && (event.keyCode < 96 || event.keyCode > 105) && event.keyCode != 8 && event.keyCode != 46);" disabled/>
                        </div>
                        <div class="col-1 mb-1">
                            <div style="height:20px"></div>
                            <button type="button" class="btn btn-icon rounded-pill btn-success  waves-effect AddSMMEBtn" id="btnAddSMMEBudget" onclick="AddSMMEBudget();" disabled>
                                <i class="tf-icons ti ti-plus"></i>
                            </button>
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-sm-12">
                            <table id="tblSMME" class="table table-bordered tbl">
                                <thead>
                                    <tr>
                                        <th>SMME</th>
                                        <th>Amount</th>
                                        <th hidden>Period</th>
                                        <th hidden>Activity</th>
                                        <th hidden>Task</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                                <tfoot>
                                    <tr>
                                        <th colspan="1"><span id="txtTaskLabelSMME1" class="txtTaskLabelSMME txSMMESpan txlblActTaskClr"></span> TOTAL</th>
